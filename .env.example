# Copy to .env (never commit .env) to override the local demo defaults of docker-compose.yml.

# SQL Server "sa" password: 8+ characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=<choose-a-strong-password>

# JWT signing key, at least 32 random characters. Generate one with:
#   openssl rand -base64 48
# or in PowerShell (cryptographic random generator):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SIGNING_KEY=<random-string-of-32+-characters>
